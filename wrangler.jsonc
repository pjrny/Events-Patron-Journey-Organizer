{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Deploys over the EXISTING Worker service "events-patronjourney" so the Odoo API key
  // and test-password secrets already set in the Cloudflare dashboard stay bound.
  "name": "events-patronjourney",
  "account_id": "0adfeaaccd1d2cfa389d7bcd33b55ee4",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  // Host on workers.dev only until the platform is proven. No routes / custom domains.
  "workers_dev": true,
  "preview_urls": true,

  // Do not wipe plain-text vars that may have been set in the dashboard.
  "keep_vars": true,

  "observability": { "enabled": true },

  // Lets src/db.ts import migrations/0001_init.sql as text for self-bootstrap.
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }],

  "vars": {
    "APP_ENV": "production",
    "ODOO_URL": "https://patronjourney.odoo.com",
    "ODOO_DB": "",
    "ODOO_TEMPLATE_EVENT_ID": "14",
    // Name of the dashboard secret that holds the Odoo admin API key.
    "ODOO_KEY_BINDING": "ODOO",
    "PAID_UPGRADE_URL": "https://www.pjrny.com/#Contact-us",
    "PUBLIC_EVENTS_URL": "https://www.patronjourney.com/event",
    "SESSION_TTL_HOURS": "12",
    "MAGIC_LINK_TTL_MINUTES": "15",
    "PUBLIC_BASE_URL": "https://events-patronjourney.message-0ad.workers.dev",
    "MAIL_FROM": "",
    // Websites organizers may publish to: 1 = Patron Journey (company 1), 2 = pjrny (company 3).
    "ALLOWED_WEBSITE_IDS": "1,2",
    // Fixed "PATRON JOURNEY" sponsor recreated on every copy (partner 20, sponsor type 4).
    "PJ_SPONSOR_PARTNER_ID": "20",
    "PJ_SPONSOR_TYPE_ID": "4",
    // Fallback product for new free tickets ("Event Registration").
    "ODOO_TICKET_PRODUCT_ID": "36",
    // Organizer self-service: first verified sign-in auto-creates the organizer when the email has an
    // Odoo res.users account; users of this website (2 = pjrny.com) are preferred.
    "ORGANIZER_SIGNUP_WEBSITE_ID": "2"
  },

  // D1 = ownership + sessions + audit ONLY. Odoo stays the source of truth.
  // Provisioned by the first `wrangler deploy` on 2026-10-07.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "events-patronjourney-db",
      "database_id": "d2cd5d56-ed66-4db2-bb2d-5520f4665115",
      "migrations_dir": "migrations"
    }
  ],

  // KV = cache only (Odoo reads such as venues, tags, event summaries). Never authoritative.
  // TEMPORARILY DISABLED: the current deploy token lacks "Workers KV Storage: Edit", so wrangler
  // cannot auto-provision the namespace. The Worker treats CACHE as optional (cache misses fall
  // through to Odoo). Re-enable once the token has KV permission:
  // "kv_namespaces": [{ "binding": "CACHE" }]
}
